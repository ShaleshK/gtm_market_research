        "jsCode": "// 🎯 VERSION SYNC: Grabs incoming data using standard n8n arrays\nconst inputItems = $input.all();\nconst firstItem = inputItems.length > 0 ? inputItems[0].json : {};\n\n// 1. Ingest the raw JSON data block from the preceding HTTP Request node\nconst rawResults = firstItem.organic_results || [];\nlet continuousText = \"\";\n\n// 2. Loop through and extract ONLY the clean text data pieces\nrawResults.forEach((result, index) => {\n    continuousText += `Source ${index + 1}: ${result.title}\\nLink: ${result.link}\\nSnippet: ${result.snippet}\\n\\n`;\n});\n\nif (!continuousText) {\n    continuousText = \"No direct organic market evidence snippets were retrieved from the search index.\";\n}\n\n// 3. Output a clean text variable contract that your Analyst Agent can read effortlessly\nreturn {\n    cleaned_search_data: continuousText\n};\n"
